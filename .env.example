# AIBuyable Gateway — Environment Variables
# Copy this file to .env and fill in your values

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (production-grade)
DATABASE_URL=postgresql://postgres:password@localhost:5432/agenticpay
# SQLite alternative (comment out the above, uncomment this):
# DATABASE_URL=sqlite:///./aibuyable.db

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ─── Encryption (for Razorpay secret storage) ─────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# ─── Google Gemini ───────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
DEFAULT_GEMINI_MODEL=gemini-1.5-flash

# ─── Razorpay ────────────────────────────────────────────────────────────────
# HARD-LOCKED to test mode for this project
RAZORPAY_MODE=test

# ─── Application ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ─── Admin Seed Account ──────────────────────────────────────────────────────
ADMIN_EMAIL=admin@aibuyable.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Platform Admin
